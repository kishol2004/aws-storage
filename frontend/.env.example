# ─── SecureDoc AI — Frontend Environment Configuration ────────────────────────
#
# Copy this file to .env and fill in your values after CDK deployment.
# The app runs in "demo mode" until VITE_API_BASE_URL and Cognito vars are set.
#
# Values are output by `cdk deploy` — see the CloudFormation outputs.

# ─── API Gateway ──────────────────────────────────────────────────────────────
# Your AWS API Gateway base URL (no trailing slash)
# Example: https://abc123xyz.execute-api.ap-south-1.amazonaws.com/v1
VITE_API_BASE_URL=

# ─── Amazon Cognito ───────────────────────────────────────────────────────────
# These are PUBLIC values — safe to include in the frontend bundle.
# Your security is enforced by the Cognito Authorizer in API Gateway.

# From CDK output: {StackPrefix}-Auth.UserPoolId
VITE_COGNITO_USER_POOL_ID=

# From CDK output: {StackPrefix}-Auth.UserPoolClientId
VITE_COGNITO_CLIENT_ID=

# AWS region where your Cognito User Pool is deployed
# Example: ap-south-1
VITE_COGNITO_REGION=ap-south-1

# ─── App Configuration ────────────────────────────────────────────────────────
VITE_APP_NAME=SecureDoc AI
